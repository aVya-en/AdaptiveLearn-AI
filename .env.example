# Gemini API keys. Keys can share project quota; optionally identify projects
# to avoid retrying another key from a project known to be exhausted.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Optional project labels (do not put secrets here).
GEMINI_PROJECT_ID_1=
GEMINI_PROJECT_ID_2=
GEMINI_PROJECT_ID_3=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_COOLDOWN_SECONDS=30
GEMINI_MAX_COOLDOWN_SECONDS=900
GEMINI_CREDENTIAL_WAIT_SECONDS=30

# Adaptive reasoning only. API calls remain disabled until explicitly enabled.
# Check your Groq Console plan, model access, and current limits before enabling.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_ALLOW_API_USAGE=false
